# ==============================================================================
# Afterhours Collective - Environment Configuration
# ==============================================================================
# Copy this file to .env.local and populate with your project credentials:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# - NEVER commit .env.local or expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# - Keys prefixed with NEXT_PUBLIC_ are bundled into client-side JavaScript.
# ==============================================================================

# Supabase Project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for client/browser requests with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER ONLY - grants admin bypass to RLS)
# DO NOT add NEXT_PUBLIC_ prefix to this variable!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
